{
  "version": 2,
  "functions": {
    "api/**": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/chapter-tests/(.*)",
      "destination": "/api/chapter-tests?slug=$1"
    },
    {
      "source": "/api/chapter-tests",
      "destination": "/api/chapter-tests"
    },
    {
      "source": "/api/sectional-tests/(.*)",
      "destination": "/api/sectional-tests?slug=$1"
    },
    {
      "source": "/api/sectional-tests",
      "destination": "/api/sectional-tests"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?slug=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
